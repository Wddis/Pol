#!/usr/bin/env bash
set -eu
cd -- "$(dirname -- "$0")"
webpy="${T2X2_WEB_PYTHON:-/workspace/t2x2/.web-venv/bin/python}"
logs="${T2X2_WEB_DATA:-/workspace/t2x2/web-jobs}"
mkdir -p "$logs"
exec 9>"$logs/panel.lock"
flock -n 9
export T2X2_RELAY_URL="${T2X2_RELAY_URL:-https://t2x2-montage.dimazoltinsky.workers.dev}"
export T2X2_RELAY_SECRET="$(cat "${T2X2_RELAY_SECRET_FILE:-$HOME/.config/t2x2/relay-secret}")"
setsid env -u T2X2_RELAY_SECRET T2X2_PANEL_GROUP=1 "$webpy" -m uvicorn server:app --host 127.0.0.1 --port 8787 >>"$logs/web-server.log" 2>&1 &
server_pid=$!
cleanup() {
  if [[ -n ${model_supervisor:-} ]]; then kill "$model_supervisor" 2>/dev/null || true; fi
  kill -KILL -- "-$server_pid" 2>/dev/null || true
  if [[ -n ${agent_pid:-} ]]; then kill "$agent_pid" 2>/dev/null || true; fi
}
trap cleanup EXIT
trap 'exit 0' INT TERM
editor_dir="${T2X2_EDITOR_DIR:-/workspace/t2x2/models/editor}"
editor_bin="$editor_dir/llama-b12828/llama-server"
if [[ -x "$editor_bin" && -f "$editor_dir/editor.gguf" ]]; then
 (
   trap 'kill "${model_pid:-0}" 2>/dev/null || true; exit 0' INT TERM
   while true; do
     "$editor_bin" -m "$editor_dir/editor.gguf" --host 127.0.0.1 --port "${T2X2_EDITOR_PORT:-8794}" \
        -ngl 0 -t 2 -c 4096 -np 1 --no-ui --cors-origins localhost --no-cors-credentials >>"$logs/editor-model.log" 2>&1 &
     model_pid=$!
     wait "$model_pid" || true
     sleep 12
   done
 ) &
 model_supervisor=$!
fi
for i in {1..20}; do
  kill -0 "$server_pid"
  if curl -fsS --max-time 1 http://127.0.0.1:8787/api/jobs >/dev/null 2>&1; then break; fi
  sleep 1
done
"$webpy" relay_agent.py >>"$logs/relay-agent.log" 2>&1 &
agent_pid=$!
wait -n "$server_pid" "$agent_pid"
