<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.recovery.farmerv8"
    android:versionCode="8" android:versionName="8.0">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34"/>

    <application
        android:label="FarmerShoot v8 (LSPatch)"
        android:icon="@android:drawable/sym_def_app_icon"
        android:allowBackup="false">

        <!-- Метки Xposed-модуля. LSPatch распознаёт модуль по xposedminversion. -->
        <meta-data android:name="xposedmodule" android:value="true"/>
        <meta-data android:name="xposedminversion" android:value="82"/>
        <meta-data android:name="xposeddescription"
            android:value="FarmerShoot v8 — живой инспектор/патчер (overlay внутри игры, ammo/jump). IL2CPP native."/>
        <!-- Область действия (scope) выбирается в LSPatch при встраивании в игру. -->

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
