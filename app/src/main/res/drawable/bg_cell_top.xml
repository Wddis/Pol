<?xml version="1.0" encoding="utf-8"?>
<!-- Верхняя строка карточки: подсветка нажатия в её границах -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#14FFFFFF">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:topLeftRadius="@dimen/corner_card" android:topRightRadius="@dimen/corner_card"
                android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp" />
        </shape>
    </item>
</ripple>
