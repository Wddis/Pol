<?xml version="1.0" encoding="utf-8"?>
<!-- Левая половина карточки: подсветка нажатия не выходит за скругление -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#14FFFFFF">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:topLeftRadius="@dimen/corner_card" android:bottomLeftRadius="@dimen/corner_card"
                android:topRightRadius="0dp" android:bottomRightRadius="0dp" />
        </shape>
    </item>
</ripple>
