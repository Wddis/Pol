<?xml version="1.0" encoding="utf-8"?>
<!-- Нижняя строка карточки: подсветка нажатия в её границах -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#14FFFFFF">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:bottomLeftRadius="@dimen/corner_card" android:bottomRightRadius="@dimen/corner_card"
                android:topLeftRadius="0dp" android:topRightRadius="0dp" />
        </shape>
    </item>
</ripple>
