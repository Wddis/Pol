<?xml version="1.0" encoding="utf-8"?>
<!-- Меню: ключ, как купить, инструкция, вопросы, поддержка, бот, конфиденциальность, о приложении -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_3"
        android:paddingEnd="@dimen/space_3"
        android:paddingBottom="@dimen/space_2">

        <View
            android:layout_width="@dimen/space_4"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_2"
            android:background="@drawable/bg_handle" />

        <TextView
            android:id="@+id/sheetTitle"
            style="@style/Text.Oda.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_3"
            android:layout_marginBottom="@dimen/space_1"
            android:textColor="@color/text_secondary" />

        <LinearLayout
            android:id="@+id/rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/body"
            style="@style/Text.Oda.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:lineSpacingExtra="4dp"
            android:textIsSelectable="true"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:orientation="vertical" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
