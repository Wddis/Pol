<?xml version="1.0" encoding="utf-8"?>
<!-- Страница: «Ключ доступа» (как в макете владельца) и справка — как купить, инструкция, вопросы и т. д. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_6"
        android:layout_marginTop="@dimen/space_2">

        <ImageView
            android:id="@+id/back"
            android:layout_width="@dimen/space_6"
            android:layout_height="@dimen/space_6"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="@dimen/space_1"
            android:background="@drawable/bg_icon_ripple"
            android:contentDescription="@string/cd_back"
            android:padding="10dp"
            android:src="@drawable/ic_back"
            android:tint="@color/text" />

        <TextView
            android:id="@+id/pageTitle"
            style="@style/Text.Oda.Heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </FrameLayout>

    <TextView
        android:id="@+id/pageSub"
        style="@style/Text.Oda.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_pad"
            android:paddingTop="@dimen/space_3"
            android:paddingEnd="@dimen/screen_pad"
            android:paddingBottom="@dimen/space_3">

            <LinearLayout
                android:id="@+id/card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_static"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_1"
                android:paddingBottom="@dimen/space_1"
                android:visibility="gone" />

            <TextView
                android:id="@+id/body"
                style="@style/Text.Oda.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_static"
                android:lineSpacingExtra="5dp"
                android:padding="@dimen/screen_pad"
                android:textIsSelectable="true"
                android:textSize="15sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
