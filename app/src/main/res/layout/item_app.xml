<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/row_height"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_3"
    android:paddingEnd="@dimen/space_3">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/space_4"
        android:layout_height="@dimen/space_4"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_2"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            style="@style/Text.Oda.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/route"
            style="@style/Text.Oda.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/check"
        android:layout_width="@dimen/space_3"
        android:layout_height="@dimen/space_3"
        android:layout_marginStart="@dimen/space_2"
        android:contentDescription="@string/apps_via_vpn"
        android:src="@drawable/ic_check" />

</LinearLayout>
