<?xml version="1.0" encoding="utf-8"?>
<!-- Строка карточки ключа: иконка в круге, подпись капслоком, значение, кнопка справа -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="80dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/screen_pad"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:id="@+id/iconBg"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_circle">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:tint="@color/text_secondary" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_3"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="@dimen/space_1"
                android:background="@drawable/bg_dot"
                android:backgroundTint="@color/accent"
                android:visibility="gone" />

            <TextView
                android:id="@+id/label"
                style="@style/Text.Oda.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/value"
            style="@style/Text.Oda.Value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/action"
        android:layout_width="@dimen/space_6"
        android:layout_height="@dimen/space_6"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:padding="12dp"
        android:tint="@color/text_secondary"
        android:visibility="gone" />
</LinearLayout>
