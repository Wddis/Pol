<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingBottom="@dimen/space_2">

    <View
        android:layout_width="@dimen/space_4"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_2"
        android:background="@drawable/bg_handle" />

    <TextView
        style="@style/Text.Oda.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_3"
        android:layout_marginBottom="@dimen/space_2"
        android:text="@string/log_title"
        android:textColor="@color/text_secondary" />

    <!-- Копировать и очистить: журнал после очистки пишется заново, подключение не трогается -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_3"
        android:layout_marginEnd="@dimen/space_3"
        android:layout_marginBottom="@dimen/space_2"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/copy"
            android:layout_width="0dp"
            android:layout_height="@dimen/row_height"
            android:layout_weight="1"
            android:backgroundTint="@color/accent"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:text="@string/log_copy"
            android:textColor="@color/on_accent"
            app:cornerRadius="@dimen/corner_pill" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/clear"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/row_height"
            android:layout_marginStart="@dimen/space_1"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:text="@string/log_clear"
            android:textColor="@color/text"
            app:cornerRadius="@dimen/corner_pill"
            app:strokeColor="@color/line" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:paddingStart="@dimen/space_2"
            android:paddingEnd="@dimen/space_2"
            android:textColor="@color/text_secondary"
            android:textIsSelectable="true"
            android:textSize="11sp" />
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
