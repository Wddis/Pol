<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_3"
    android:paddingEnd="@dimen/space_3">

    <TextView
        android:id="@+id/title"
        style="@style/Text.Oda.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_3"
        android:text="@string/title" />

    <!-- Строка выбора страны -->
    <LinearLayout
        android:id="@+id/countryRow"
        android:layout_width="match_parent"
        android:layout_height="@dimen/row_height"
        android:layout_marginTop="@dimen/space_4"
        android:background="@drawable/bg_row"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_2"
        android:paddingEnd="@dimen/space_2">

        <TextView
            android:id="@+id/countryCode"
            style="@style/Text.Oda.Code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/space_4" />

        <TextView
            android:id="@+id/countryName"
            style="@style/Text.Oda.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1" />

        <ImageView
            android:layout_width="@dimen/space_3"
            android:layout_height="@dimen/space_3"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_expand" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.example.vpnapp.PowerButtonView
        android:id="@+id/powerButton"
        android:layout_width="@dimen/power_button"
        android:layout_height="@dimen/power_button"
        android:layout_gravity="center_horizontal" />

    <TextView
        android:id="@+id/status"
        style="@style/Text.Oda.Status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_4"
        android:accessibilityLiveRegion="polite"
        android:text="@string/status_off" />

    <TextView
        android:id="@+id/details"
        style="@style/Text.Oda.Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_1"
        android:gravity="center" />

    <!-- Проверка IP во встроенном браузере через Tor -->
    <TextView
        android:id="@+id/checkLink"
        style="@style/Text.Oda.Link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_1"
        android:text="@string/link_check"
        android:visibility="invisible" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Короткий текст ошибки -->
    <TextView
        android:id="@+id/error"
        style="@style/Text.Oda.Small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:gravity="center"
        android:minHeight="@dimen/space_4"
        android:textColor="@color/text" />

    <!-- Нижние ссылки: мосты и kill switch -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/space_2"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/bridgesLink"
            style="@style/Text.Oda.Link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/killSwitch"
            style="@style/Text.Oda.Link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/link_kill_switch" />
    </LinearLayout>

</LinearLayout>
