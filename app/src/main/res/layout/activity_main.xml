<?xml version="1.0" encoding="utf-8"?>
<!-- Главный экран 0.12: вкладки «Главная», «История», «Настройки» и нижняя навигация (Material) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/pages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ========== Главная: всё в один экран, по пропорциям (ConstraintLayout) ========== -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/pageHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/screen_pad"
            android:paddingEnd="@dimen/screen_pad"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/title"
                style="@style/Text.Oda.Logo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="@string/title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tagline"
                style="@style/Text.Oda.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/tagline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/title" />

            <ImageView
                android:id="@+id/menuButton"
                android:layout_width="@dimen/space_6"
                android:layout_height="@dimen/space_6"
                android:background="@drawable/bg_icon_ripple"
                android:contentDescription="@string/cd_menu"
                android:padding="12dp"
                android:src="@drawable/ic_menu"
                android:tint="@color/text_secondary"
                app:layout_constraintBottom_toBottomOf="@id/title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/title" />

            <!-- Способ и приложения — одна карточка из двух строк -->
            <LinearLayout
                android:id="@+id/connCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card_static"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tagline">

                <include
                    android:id="@+id/modeRow"
                    layout="@layout/item_line"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="72dp"
                    android:background="@drawable/bg_divider" />

                <include
                    android:id="@+id/appsRow"
                    layout="@layout/item_line"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Ключ заканчивается (за 2 дня): одна строка, «Продлить» — в боте -->
            <LinearLayout
                android:id="@+id/keyBanner"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginTop="@dimen/space_1"
                android:background="@drawable/bg_banner"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_2"
                android:paddingEnd="@dimen/space_2"
                android:stateListAnimator="@animator/press"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/connCard">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_key"
                    android:tint="@color/accent" />

                <TextView
                    android:id="@+id/keyBannerText"
                    style="@style/Text.Oda.CardSub"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text" />

                <TextView
                    style="@style/Text.Oda.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/banner_action"
                    android:textColor="@color/accent" />
            </LinearLayout>

            <!-- Кнопка: всё свободное место между карточкой и статусом, квадрат 96–232 dp -->
            <com.example.vpnapp.PowerButtonView
                android:id="@+id/powerButton"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"
                app:layout_constraintBottom_toTopOf="@id/status"
                app:layout_constraintDimensionRatio="W,1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_max="232dp"
                app:layout_constraintHeight_min="96dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/keyBanner"
                app:layout_goneMarginTop="12dp" />

            <TextView
                android:id="@+id/status"
                style="@style/Text.Oda.Status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:text="@string/status_off"
                app:layout_constraintBottom_toTopOf="@id/indicatorRow"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Индикатор: серый — не подключено, зелёный — подключено, красный — ошибка -->
            <LinearLayout
                android:id="@+id/indicatorRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toTopOf="@id/error"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <View
                    android:id="@+id/indicator"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_dot" />

                <TextView
                    android:id="@+id/details"
                    style="@style/Text.Oda.CardSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:accessibilityLiveRegion="polite"
                    android:ellipsize="end"
                    android:maxLines="1" />
            </LinearLayout>

            <!-- Пояснение (запасной путь Psiphon) или текст ошибки -->
            <TextView
                android:id="@+id/error"
                style="@style/Text.Oda.CardSub"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:textSize="12sp"
                android:visibility="gone"
                app:layout_constraintBottom_toTopOf="@id/timer"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Секундомер (место занято всегда: экран не «прыгает») -->
            <TextView
                android:id="@+id/timer"
                style="@style/Text.Oda.Timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_pill"
                android:contentDescription="@string/cd_timer"
                android:paddingStart="28dp"
                android:paddingTop="7dp"
                android:paddingEnd="28dp"
                android:paddingBottom="7dp"
                android:text="00:00"
                android:visibility="invisible"
                app:layout_constraintBottom_toTopOf="@id/speedCard"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Пинг и загрузка | Тест скорости -->
            <LinearLayout
                android:id="@+id/speedCard"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_card_static"
                android:baselineAligned="false"
                android:orientation="horizontal"
                app:layout_constraintBottom_toTopOf="@id/toolsCard"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.3"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_2"
                    android:paddingEnd="@dimen/space_1">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_speed"
                        android:tint="@color/text" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/speedPing"
                            style="@style/Text.Oda.CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="@string/speed_ping_none" />

                        <TextView
                            android:id="@+id/speedLoad"
                            style="@style/Text.Oda.CardSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/speed_load_none"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_divider" />

                <!-- Тест скорости: значок и подпись под ним -->
                <LinearLayout
                    android:id="@+id/speedLink"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_cell_right"
                    android:clickable="true"
                    android:contentDescription="@string/speed_test"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/speedLinkIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chart"
                        android:tint="@color/accent" />

                    <TextView
                        android:id="@+id/speedLinkText"
                        style="@style/Text.Oda.CardSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:maxLines="1"
                        android:text="@string/speed_test"
                        android:textColor="@color/text"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Способ | Kill switch -->
            <LinearLayout
                android:id="@+id/toolsCard"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginTop="@dimen/space_1"
                android:background="@drawable/bg_card_static"
                android:baselineAligned="false"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <LinearLayout
                    android:id="@+id/engineCell"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_cell_left"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_2"
                    android:paddingEnd="@dimen/space_1">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_shield"
                        android:tint="@color/text" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Oda.CardSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/engine_label"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@+id/engineValue"
                            style="@style/Text.Oda.CardSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/text" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_divider" />

                <LinearLayout
                    android:id="@+id/killSwitch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_cell_right"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_2"
                    android:paddingEnd="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Oda.CardSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/kill_switch_label"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@+id/killValue"
                            style="@style/Text.Oda.CardSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textColor="@color/text" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/killSwitchToggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false"
                        android:importantForAccessibility="no"
                        android:minHeight="0dp"
                        app:thumbTint="@color/switch_thumb"
                        app:trackTint="@color/switch_track" />
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ========== История ========== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/pageHistory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_pad"
                android:paddingEnd="@dimen/screen_pad"
                android:paddingBottom="@dimen/space_3">

                <TextView
                    style="@style/Text.Oda.Logo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:text="@string/history_title"
                    android:textSize="24sp" />

                <TextView
                    style="@style/Text.Oda.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/history_sub" />

                <LinearLayout
                    android:id="@+id/historyList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:orientation="vertical" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/historyLog"
                    style="@style/Widget.Oda.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:text="@string/history_log"
                    app:icon="@drawable/ic_list" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/historyClear"
                    style="@style/Widget.Oda.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:text="@string/history_clear"
                    app:icon="@drawable/ic_close" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ========== Настройки ========== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/pageSettings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_pad"
                android:paddingEnd="@dimen/screen_pad"
                android:paddingBottom="@dimen/space_3">

                <TextView
                    style="@style/Text.Oda.Logo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:text="@string/settings_title"
                    android:textSize="24sp" />

                <TextView
                    style="@style/Text.Oda.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/settings_sub" />

                <LinearLayout
                    android:id="@+id/settingsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:orientation="vertical" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/nav_bg"
        app:itemActiveIndicatorStyle="@style/Widget.Oda.NavIndicator"
        app:itemIconTint="@color/nav_item"
        app:itemRippleColor="#14FFFFFF"
        app:itemTextAppearanceActive="@style/Text.Oda.NavLabel"
        app:itemTextAppearanceInactive="@style/Text.Oda.NavLabel"
        app:itemTextColor="@color/nav_item"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/nav" />
</LinearLayout>
