<?xml version="1.0" encoding="utf-8"?>
<!-- Главный экран 0.11 (макет владельца): вкладки «Главная», «История», «Настройки» и нижняя навигация -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/pages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ========== Главная ========== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/pageHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/homeContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_pad"
                android:paddingEnd="@dimen/screen_pad"
                android:paddingBottom="@dimen/space_2">

                <!-- Шапка: ODA, подпись, меню -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/title"
                            style="@style/Text.Oda.Logo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/title" />

                        <TextView
                            style="@style/Text.Oda.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/tagline" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/menuButton"
                        android:layout_width="@dimen/space_6"
                        android:layout_height="@dimen/space_6"
                        android:background="@drawable/bg_icon_ripple"
                        android:contentDescription="@string/cd_menu"
                        android:padding="10dp"
                        android:src="@drawable/ic_menu"
                        android:tint="@color/text_secondary" />
                </LinearLayout>

                <!-- Способ и приложения (страна выхода — во вкладке «Настройки») -->
                <include
                    android:id="@+id/modeRow"
                    layout="@layout/item_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp" />

                <include
                    android:id="@+id/appsRow"
                    layout="@layout/item_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- Ключ заканчивается (за 2 дня): одна строка, «Продлить» — в боте -->
                <LinearLayout
                    android:id="@+id/keyBanner"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="@dimen/space_1"
                    android:background="@drawable/bg_banner"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_2"
                    android:paddingEnd="@dimen/space_2"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_key"
                        android:tint="@color/accent" />

                    <TextView
                        android:id="@+id/keyBannerText"
                        style="@style/Text.Oda.CardSub"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text" />

                    <TextView
                        style="@style/Text.Oda.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/banner_action"
                        android:textColor="@color/accent" />
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="@dimen/space_2" />

                <com.example.vpnapp.PowerButtonView
                    android:id="@+id/powerButton"
                    android:layout_width="@dimen/power_button"
                    android:layout_height="@dimen/power_button"
                    android:layout_gravity="center_horizontal" />

                <TextView
                    android:id="@+id/status"
                    style="@style/Text.Oda.Status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:accessibilityLiveRegion="polite"
                    android:text="@string/status_off" />

                <!-- Индикатор: серый — не подключено, зелёный — подключено, красный — ошибка -->
                <LinearLayout
                    android:id="@+id/indicatorRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/indicator"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_dot" />

                    <TextView
                        android:id="@+id/details"
                        style="@style/Text.Oda.CardSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:accessibilityLiveRegion="polite"
                        android:ellipsize="end"
                        android:maxLines="1" />
                </LinearLayout>

                <!-- Пояснения к подключению (запасной путь Psiphon и т. п.) или текст ошибки -->
                <TextView
                    android:id="@+id/error"
                    style="@style/Text.Oda.CardSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:accessibilityLiveRegion="polite"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <!-- Секундомер -->
                <TextView
                    android:id="@+id/timer"
                    style="@style/Text.Oda.Timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_pill"
                    android:contentDescription="@string/cd_timer"
                    android:paddingStart="28dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="28dp"
                    android:paddingBottom="8dp"
                    android:visibility="invisible" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="@dimen/space_2" />

                <!-- Пинг и загрузка | Тест скорости -->
                <LinearLayout
                    android:id="@+id/speedCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_static"
                    android:baselineAligned="false"
                    android:minHeight="72dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_2"
                        android:paddingEnd="@dimen/space_1">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_speed"
                            android:tint="@color/text" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Text.Oda.CardSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/speed_ping" />

                            <TextView
                                android:id="@+id/speedPing"
                                style="@style/Text.Oda.CardTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/speed_none" />

                            <TextView
                                android:id="@+id/speedLoad"
                                style="@style/Text.Oda.CardSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textSize="11.5sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:layout_marginTop="@dimen/space_2"
                        android:layout_marginBottom="@dimen/space_2"
                        android:background="@drawable/bg_divider" />

                    <LinearLayout
                        android:id="@+id/speedLink"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_cell_right"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_2"
                        android:paddingEnd="@dimen/space_2">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chart"
                            android:tint="@color/text" />

                        <TextView
                            android:id="@+id/speedLinkText"
                            style="@style/Text.Oda.CardTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/speed_test"
                            android:textSize="14sp" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_right"
                            android:tint="@color/text_secondary" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Способ | Kill switch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:background="@drawable/bg_card_static"
                    android:baselineAligned="false"
                    android:minHeight="68dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/engineCell"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_cell_left"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_2"
                        android:paddingEnd="@dimen/space_1">

                        <FrameLayout
                            android:layout_width="@dimen/icon_circle"
                            android:layout_height="@dimen/icon_circle"
                            android:background="@drawable/bg_circle">

                            <ImageView
                                android:layout_width="@dimen/icon_small"
                                android:layout_height="@dimen/icon_small"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_shield"
                                android:tint="@color/text" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Text.Oda.CardSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/engine_label" />

                            <TextView
                                android:id="@+id/engineValue"
                                style="@style/Text.Oda.CardSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/text" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:layout_marginTop="@dimen/space_2"
                        android:layout_marginBottom="@dimen/space_2"
                        android:background="@drawable/bg_divider" />

                    <LinearLayout
                        android:id="@+id/killSwitch"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_cell_right"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_2"
                        android:paddingEnd="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Text.Oda.CardSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/kill_switch_label" />

                            <TextView
                                android:id="@+id/killValue"
                                style="@style/Text.Oda.CardSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/text" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/killSwitchToggle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:focusable="false"
                            android:importantForAccessibility="no"
                            app:thumbTint="@color/switch_thumb"
                            app:trackTint="@color/switch_track" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ========== История ========== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/pageHistory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_pad"
                android:paddingEnd="@dimen/screen_pad"
                android:paddingBottom="@dimen/space_3">

                <TextView
                    style="@style/Text.Oda.Logo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:text="@string/history_title"
                    android:textSize="24sp" />

                <TextView
                    style="@style/Text.Oda.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/history_sub" />

                <LinearLayout
                    android:id="@+id/historyList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:orientation="vertical" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/historyLog"
                    style="@style/Widget.Oda.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:text="@string/history_log"
                    app:icon="@drawable/ic_list" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/historyClear"
                    style="@style/Widget.Oda.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:text="@string/history_clear"
                    app:icon="@drawable/ic_close" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ========== Настройки ========== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/pageSettings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_pad"
                android:paddingEnd="@dimen/screen_pad"
                android:paddingBottom="@dimen/space_3">

                <TextView
                    style="@style/Text.Oda.Logo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:text="@string/settings_title"
                    android:textSize="24sp" />

                <TextView
                    style="@style/Text.Oda.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/settings_sub" />

                <LinearLayout
                    android:id="@+id/settingsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:orientation="vertical" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>

    <!-- Нижняя навигация: подсветка нажатия — круг вокруг иконки -->
    <LinearLayout
        android:id="@+id/nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/nav_bg"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="@dimen/nav_height"
            android:layout_weight="1">

            <FrameLayout
                android:id="@+id/navHome"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_nav_ripple"
                android:clickable="true"
                android:contentDescription="@string/nav_home"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="4dp"
                    android:duplicateParentState="true"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_home"
                    android:tint="@color/nav_tint" />

                <View
                    android:layout_width="22dp"
                    android:layout_height="3dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/bg_nav_indicator"
                    android:tag="indicator"
                    android:visibility="invisible" />
            </FrameLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="@dimen/nav_height"
            android:layout_weight="1">

            <FrameLayout
                android:id="@+id/navHistory"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_nav_ripple"
                android:clickable="true"
                android:contentDescription="@string/nav_history"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="4dp"
                    android:duplicateParentState="true"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_history"
                    android:tint="@color/nav_tint" />

                <View
                    android:layout_width="22dp"
                    android:layout_height="3dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/bg_nav_indicator"
                    android:tag="indicator"
                    android:visibility="invisible" />
            </FrameLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="@dimen/nav_height"
            android:layout_weight="1">

            <FrameLayout
                android:id="@+id/navSettings"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_nav_ripple"
                android:clickable="true"
                android:contentDescription="@string/nav_settings"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="4dp"
                    android:duplicateParentState="true"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_settings"
                    android:tint="@color/nav_tint" />

                <View
                    android:layout_width="22dp"
                    android:layout_height="3dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/bg_nav_indicator"
                    android:tag="indicator"
                    android:visibility="invisible" />
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
