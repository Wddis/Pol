<?xml version="1.0" encoding="utf-8"?>
<!-- Строка-карточка: иконка в круге, название, пояснение, значение, стрелка -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_1"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_2"
    android:paddingTop="10dp"
    android:paddingEnd="@dimen/space_2"
    android:paddingBottom="10dp">

    <FrameLayout
        android:id="@+id/iconBg"
        android:layout_width="@dimen/icon_circle"
        android:layout_height="@dimen/icon_circle"
        android:background="@drawable/bg_circle">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="@dimen/icon_small"
            android:layout_height="@dimen/icon_small"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:tint="@color/text" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_2"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            style="@style/Text.Oda.CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/subtitle"
            style="@style/Text.Oda.CardSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/value"
        style="@style/Text.Oda.CardSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_1"
        android:maxWidth="140dp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/chevron"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="@dimen/space_1"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        android:tint="@color/text_secondary" />
</LinearLayout>
