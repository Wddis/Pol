<?xml version="1.0" encoding="utf-8"?>
<!-- Экран ключа (0.11): ввод ключа, «Тариф закончился», «Доступ заблокирован», «Нужна проверка» -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_pad"
        android:paddingEnd="@dimen/screen_pad">

        <TextView
            style="@style/Text.Oda.Logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:text="@string/title" />

        <TextView
            style="@style/Text.Oda.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/tagline" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/space_3" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_static"
            android:orientation="vertical"
            android:padding="@dimen/space_3">

            <FrameLayout
                android:id="@+id/keyIconBg"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_circle_accent">

                <ImageView
                    android:id="@+id/keyIcon"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_key"
                    android:tint="@color/accent" />
            </FrameLayout>

            <TextView
                android:id="@+id/headline"
                style="@style/Text.Oda.Status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_2"
                android:gravity="center"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/body"
                style="@style/Text.Oda.CardSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/keyInput"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/space_3"
                android:autofillHints=""
                android:background="@drawable/bg_input"
                android:fontFamily="monospace"
                android:gravity="center"
                android:hint="@string/key_hint"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="textCapCharacters|textNoSuggestions|textVisiblePassword"
                android:maxLength="24"
                android:paddingStart="@dimen/space_2"
                android:paddingEnd="@dimen/space_2"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/idle"
                android:textSize="18sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/primary"
                style="@style/Widget.Oda.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/secondary"
                style="@style/Widget.Oda.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <!-- Ошибка или результат -->
            <TextView
                android:id="@+id/message"
                style="@style/Text.Oda.CardSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:textColor="@color/danger" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/space_2" />

        <TextView
            android:id="@+id/trialHint"
            style="@style/Text.Oda.CardSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/key_trial_hint" />

        <TextView
            android:id="@+id/getKey"
            style="@style/Text.Oda.Link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/key_get"
            android:textColor="@color/accent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/space_2"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/howBuy"
                style="@style/Text.Oda.Link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/key_how_buy" />

            <TextView
                android:id="@+id/support"
                style="@style/Text.Oda.Link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/key_support" />

            <TextView
                android:id="@+id/logLink"
                style="@style/Text.Oda.Link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/link_log" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
