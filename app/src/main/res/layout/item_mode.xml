<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/row_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_3"
    android:paddingTop="@dimen/space_1"
    android:paddingEnd="@dimen/space_3"
    android:paddingBottom="@dimen/space_1">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            style="@style/Text.Oda.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/hint"
            style="@style/Text.Oda.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/check"
        android:layout_width="@dimen/space_3"
        android:layout_height="@dimen/space_3"
        android:layout_marginStart="@dimen/space_2"
        android:contentDescription="@string/cd_selected"
        android:src="@drawable/ic_check"
        android:visibility="invisible" />

</LinearLayout>
