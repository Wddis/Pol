<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Единственная тема: тёмная, чёрно-белая -->
    <style name="Theme.Oda" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/text</item>
        <item name="colorOnPrimary">@color/bg</item>
        <item name="colorSecondary">@color/text_secondary</item>
        <item name="colorOnSecondary">@color/bg</item>
        <item name="colorSurface">@color/bg</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/line</item>
        <item name="colorControlHighlight">#1AFFFFFF</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Oda.BottomSheet</item>
    </style>

    <style name="ThemeOverlay.Oda.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Oda.BottomSheet</item>
        <item name="android:backgroundDimAmount">0.7</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>

    <!-- Фон рисует сам контент листа (с обводкой), контейнер прозрачный -->
    <style name="Widget.Oda.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="paddingBottomSystemWindowInsets">false</item>
    </style>

    <!-- Текстовые стили -->
    <style name="Text.Oda" parent="">
        <item name="android:textColor">@color/text</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.Oda.Title">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.4</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Text.Oda.Status">
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="Text.Oda.Code">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <style name="Text.Oda.Body">
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Text.Oda.Link">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>

    <style name="Text.Oda.Small">
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

</resources>
