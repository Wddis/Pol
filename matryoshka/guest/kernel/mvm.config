# Matryoshka VM guest kernel fragment.
# Apply on top of the arm64 GKI defconfig of an android11-5.4 / android12-5.10 common kernel:
#   scripts/kconfig/merge_config.sh arch/arm64/configs/gki_defconfig mvm.config
# Everything is built in (=y): the guest boots without a vendor ramdisk / modules.

# Paravirtual machine (crosvm / QEMU "virt")
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_INPUT=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_RTC_DRV_PL031=y

# Display
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y

# Host hand-off share (/mvm)
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y

# Android essentials
CONFIG_ANDROID=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ASHMEM=y
CONFIG_FUSE_FS=y
CONFIG_TUN=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_QUOTA=y
CONFIG_QFMT_V2=y

# Memory efficiency inside the VM
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_PSI=y

# Keep the guest light
# CONFIG_WLAN is not set
# CONFIG_BT is not set
# CONFIG_NFC is not set
# CONFIG_USB_SUPPORT is not set
