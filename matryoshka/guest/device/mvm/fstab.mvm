# Matryoshka VM guest fstab (hypervisor / emulator engines).
# Disks are attached by the host in this fixed order. /data is formatted on the very first boot
# ("formattable"): the host only creates an empty sparse file of the chosen size.
#<src>            <mnt_point>  <type>  <mnt_flags>                                  <fs_mgr_flags>
/dev/block/vda    /system      ext4    ro,barrier=1                                 wait,first_stage_mount
/dev/block/vdb    /vendor      ext4    ro,barrier=1                                 wait,first_stage_mount
/dev/block/vdc    /data        ext4    noatime,nosuid,nodev,discard,errors=panic    wait,check,formattable,quota,reservedsize=64m
