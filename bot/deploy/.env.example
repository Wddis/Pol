# Скопируйте в .env (install.sh делает это сам). Файл .env — только на сервере, в git не попадает.
BOT_TOKEN=
# Ваш Telegram ID (через запятую — несколько)
ODA_ADMIN_IDS=
# Домен сервера ключей (A-запись на IP сервера), например keys.example.com; пусто — без HTTPS
ODA_DOMAIN=
# Без домена сервер ключей открыт на :8080 (0.0.0.0); с доменом — только через Caddy
ODA_BIND=127.0.0.1
ODA_PRICE_WEEK=0
ODA_PRICE_MONTH=0
ODA_PRICE_3M=0
ODA_EXTRA_DEVICE_PCT=50
# 1 — ключи без оплаты (оплата ещё не подключена)
ODA_FREE_MODE=1
ODA_APK_URL=
ODA_SUPPORT=
